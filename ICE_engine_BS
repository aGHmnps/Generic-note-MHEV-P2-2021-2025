def _get_bin_metadata(bins):
    if len(bins) < 2:
        return "min=0;max=0;step=0"
    bin_min = bins[0]
    bin_max = bins[-1]
    step = bins[1] - bins[0] if len(bins) > 1 else 0
    if float(step).is_integer():
        return f"min={int(bin_min)};max={int(bin_max)};step={int(step)}"
    return f"min={bin_min};max={bin_max};step={step}"


def _build_bin_label(i, low, high, unit):
    """
    Build label like:
      i=0:  '0000 [-100RPM:-50RPM]'
      i=1:  '0001 ]-50RPM:0RPM]'
      i=67: '0067 ]0N.m:5N.m]'
    """
    # Zero-pad index to 4 digits
    idx_str = f"{i:04d}"

    # Format low/high as integers if possible
    low_str = str(int(low)) if float(low).is_integer() else str(low)
    high_str = str(int(high)) if float(high).is_integer() else str(high)

    if i == 0:
        return f"{idx_str} [{low_str}{unit}:{high_str}{unit}]"
    else:
        return f"{idx_str} ]{low_str}{unit}:{high_str}{unit}]"


def _build_all_bin_labels(bins, unit):
    """Pre-build all bin labels for fast lookup by index."""
    labels = []
    for i in range(len(bins) - 1):
        labels.append(_build_bin_label(i, bins[i], bins[i + 1], unit))
    return labels


def assign_bin_index_exact(values, bins):
    """
    first bin:  >= low and <= high
    other bins: > low and <= high
    """
    values = np.asarray(values, dtype=float)
    out = np.full(values.shape, np.nan)
    for i in range(len(bins) - 1):
        low, high = bins[i], bins[i + 1]
        if i == 0:
            mask = (values >= low) & (values <= high)
        else:
            mask = (values > low) & (values <= high)
        out[mask] = i
    return out


def _create_empty_json_with_metadata(x_col, y_col, x_bins, y_bins):
    result = {
        "x_axis": x_col,
        "y_axis": y_col,
        "x_bins": _get_bin_metadata(x_bins),
        "y_bins": _get_bin_metadata(y_bins),
        "matrix": {}
    }
    return json.dumps(result, separators=(',', ':'))

    
def _calculate_h2d_matrix_json_count(df, x_col, y_col, x_bins, y_bins, x_unit, y_unit, freq=100):
    """
    H2D duration matrix with nested dict format and indexed bin labels:
      "matrix": {
          "0000 [-100RPM:-50RPM]": {
              "0000 [-120N.m:-115N.m]": {"none": 0.01},
              "0001 ]-115N.m:-110N.m]": {"none": 1.23}
          },
          "0001 ]-50RPM:0RPM]": { ... }
      }
    """
    dt = 1.0 / freq

    if df.empty or x_col not in df.columns or y_col not in df.columns:
        return _create_empty_json_with_metadata(x_col, y_col, x_bins, y_bins)

    tmp = df[[x_col, y_col]].copy()
    x_vals = pd.to_numeric(tmp[x_col], errors="coerce").values
    y_vals = pd.to_numeric(tmp[y_col], errors="coerce").values

    valid_mask = ~(np.isnan(x_vals) | np.isnan(y_vals))
    x_vals = x_vals[valid_mask]
    y_vals = y_vals[valid_mask]

    if len(x_vals) == 0:
        return _create_empty_json_with_metadata(x_col, y_col, x_bins, y_bins)

    x_idx = assign_bin_index_exact(x_vals, x_bins)
    y_idx = assign_bin_index_exact(y_vals, y_bins)

    valid_bins = ~(np.isnan(x_idx) | np.isnan(y_idx))
    x_idx = x_idx[valid_bins].astype(int)
    y_idx = y_idx[valid_bins].astype(int)

    if len(x_idx) == 0:
        return _create_empty_json_with_metadata(x_col, y_col, x_bins, y_bins)

    # Pre-build label lookup arrays (original format with index prefix)
    x_labels = _build_all_bin_labels(x_bins, x_unit)
    y_labels = _build_all_bin_labels(y_bins, y_unit)

    # Accumulate durations by bin index pair
    matrix_acc = {}
    for xi, yi in zip(x_idx, y_idx):
        key = (int(xi), int(yi))
        matrix_acc[key] = matrix_acc.get(key, 0.0) + dt

    # Convert to nested dict format
    matrix = {}
    for (key_x, key_y), value in sorted(matrix_acc.items(), key=lambda kv: (kv[0][0], kv[0][1])):
        x_label = x_labels[key_x]
        y_label = y_labels[key_y]
        if x_label not in matrix:
            matrix[x_label] = {}
        matrix[x_label][y_label] = {"none": round(value, 6)}

    result = {
        "x_axis": x_col,
        "y_axis": y_col,
        "x_bins": _get_bin_metadata(x_bins),
        "y_bins": _get_bin_metadata(y_bins),
        "matrix": matrix
    }

    return json.dumps(result, separators=(',', ':'))

