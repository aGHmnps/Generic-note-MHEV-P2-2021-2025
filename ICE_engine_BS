def ICE_starts_per_trip(pdf: pd.DataFrame) -> pd.DataFrame:
    """
    applyInPandas function: counts ICE engine starts (GW logic) per trip.

    1. Preprocess RPM with GlyphWorks rising-ramp isolator
    2. demarrage_mth = 1 if processed_rpm > 0, else 0
    3. Count 0->1 transitions in demarrage_mth
    4. Classify by ORIGINAL speed at transition point:
       - speed > 0.5 km/h  => veh_roulant
       - speed <= 0.5 km/h => veh_arrete

    Output schema:
