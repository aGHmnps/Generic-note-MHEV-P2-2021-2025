                    value = float(z_dict.get('none', 0.0))
                    
                    if rpm_bin in aggregated_matrix[torque_bin]:
                        # Sum with existing value
                        aggregated_matrix[torque_bin][rpm_bin]['none'] += value
                    else:
                        # Initialize new bin
                        aggregated_matrix[torque_bin][rpm_bin] = {'none': value}
                        
        except (json.JSONDecodeError, TypeError, KeyError, AttributeError) as e:
            # Skip invalid JSON or malformed data
            print(f"Warning: Skipping invalid matrix for {driver_id}: {e}")
            continue
    
    # Build result JSON string
    if aggregated_matrix and metadata:
        result_json = {
            **metadata,
            'matrix': aggregated_matrix
        }
        aggregated_json_str = json.dumps(result_json)
    else:
        aggregated_json_str = None
    
    # Return single-row DataFrame
    return pd.DataFrame([{
        'DRIVER_ID': driver_id,
        'month': month,
        'year': year,
        'num_trips': num_trips,
        'BS_total_duration_H2D_matrix_rpm_torque': aggregated_json_str
    }])

#------------- ICE duration H2D per gear
def _aggregate_matrix_jsons_matrix_only(json_strings):
    """
    Takes a list of JSON strings (trip-level matrices in nested dict format),
    sums all values across trips.
    Returns ONLY the matrix dict as JSON string (no metadata header).
    
    Input format per JSON:
    {
        "x_axis": "REGIME_MOTEUR",
        "y_axis": "COUPLE_MOTEUR",
        "x_bins": "min=-100;max=8000;step=50",
        "y_bins": "min=-500;max=495;step=5",
        "matrix": {
            "0001 ]-50RPM:0RPM]": {
                "0083 ]-85N.m:-80N.m]": {"none": 0.03},
                ...
            }
        }
    }
    
    Output: just the matrix as JSON string:
    {"0001 ]-50RPM:0RPM]":{"0083 ]-85N.m:-80N.m]":{"none":0.03},...},...}
    """
    aggregated_matrix = {}

    for js in json_strings:
        if js is None or js == "":
            continue
        try:
            parsed = json.loads(js)
        except (json.JSONDecodeError, TypeError):
            continue

        matrix = parsed.get("matrix", {})
        if not isinstance(matrix, dict):
            continue

        for x_key, y_dict in matrix.items():
            if not isinstance(y_dict, dict):
                continue
            if x_key not in aggregated_matrix:
                aggregated_matrix[x_key] = {}
            for y_key, val_dict in y_dict.items():
                if isinstance(val_dict, dict):
                    val = val_dict.get("none", 0.0)
                elif isinstance(val_dict, (int, float)):
                    val = val_dict
                else:
                    continue
                aggregated_matrix[x_key][y_key] = aggregated_matrix[x_key].get(y_key, 0.0) + val

    # Sort and round
    sorted_matrix = {}
    for x_key in sorted(aggregated_matrix.keys()):
        sorted_matrix[x_key] = {}
        for y_key in sorted(aggregated_matrix[x_key].keys()):
            sorted_matrix[x_key][y_key] = {"none": round(aggregated_matrix[x_key][y_key], 6)}

    # Return ONLY the matrix — no metadata wrapper
    return json.dumps(sorted_matrix, separators=(',', ':'))

