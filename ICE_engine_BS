import pandas as pd

def main_ice_trips_fn(pdf: pd.DataFrame) -> pd.DataFrame:
    """
    Master trip-level function. Calls every unit metric on the same trip
    pandas DataFrame and stitches a single 1-row DataFrame matching
    `main_ice_trips_schema`.

    Includes:
        - ICE_stops_per_trip                              (1 col)
        - ICE_starts_per_trip                             (2 cols)
        - ICE_duration_veh_roulant_per_gear_trips         (7 JSON cols)
        - BS_H2D_duree_trips_matrix                       (1 JSON col)
        - H1D_all_engine_events                           (5 JSON cols)
        - RIPPLE_overload_duration_ratio_trips            (8 scalar cols)
    """

    # ---- Empty input safeguard ----
    if pdf is None or pdf.empty:
        empty = {f.name: None for f in main_ice_trips_schema.fields}
        return pd.DataFrame([empty])

    driver_id = str(pdf["DRIVER_ID"].iloc[0]) if "DRIVER_ID" in pdf.columns else ""
    trip_id = float(pdf["TRIP_ID"].iloc[0]) if "TRIP_ID" in pdf.columns else 0.0

    # Helper: extract a column from a unit-function result safely
    def _get(df, col, default=None):
        try:
            if df is None or df.empty or col not in df.columns:
                return default
            return df[col].iloc[0]
        except Exception:
            return default

    # ====================================================================
    # 1) ICE stops  (1 row)
    # ====================================================================
    try:
        stops_df = ICE_stops_per_trip(pdf)
    except Exception as e:
        print(f"[main_ice_trips_fn] ICE_stops_per_trip failed for {driver_id}/{trip_id}: {e}")
        stops_df = pd.DataFrame()

    # ====================================================================
    # 2) ICE starts (1 row)
    # ====================================================================
    try:
        starts_df = ICE_starts_per_trip(pdf)
    except Exception as e:
        print(f"[main_ice_trips_fn] ICE_starts_per_trip failed for {driver_id}/{trip_id}: {e}")
        starts_df = pd.DataFrame()

    # ====================================================================
    # 3) H2D ICE duration per gear  (7 rows → 7 columns)
    # ====================================================================
    try:
        h2d_gear_df = ICE_duration_veh_roulant_per_gear_trips(pdf)
    except Exception as e:
        print(f"[main_ice_trips_fn] ICE_duration_veh_roulant_per_gear_trips failed for {driver_id}/{trip_id}: {e}")
        h2d_gear_df = pd.DataFrame(columns=[
            "DRIVER_ID", "TRIP_ID", "mode",
            "h2d_duree_ICE_duration_veh_roulant_per_gear_trips_matrix_json"
        ])

    gear_cols = {f"h2d_duree_ICE_gear_{g}_json": None for g in range(7)}
    if not h2d_gear_df.empty:
        for _, row in h2d_gear_df.iterrows():
            mode = row.get("mode", "")
            if isinstance(mode, str) and mode.startswith("gear_"):
                try:
                    g = int(mode.split("_")[1])
                    if 0 <= g <= 6:
                        gear_cols[f"h2d_duree_ICE_gear_{g}_json"] = row[
                            "h2d_duree_ICE_duration_veh_roulant_per_gear_trips_matrix_json"
                        ]
                except (ValueError, IndexError):
                    continue

    # ====================================================================
    # 4) BS H2D matrix  (1 row)
    # ====================================================================
    try:
        bs_df = BS_H2D_duree_trips_matrix(pdf)
        bs_h2d_json = _get(bs_df, "h2d_matrix_json", None)
    except Exception as e:
        print(f"[main_ice_trips_fn] BS_H2D_duree_trips_matrix failed for {driver_id}/{trip_id}: {e}")
        bs_h2d_json = None

    # ====================================================================
    # 5) H1D engine events (1 row, 5 JSON columns)
    # ====================================================================
    try:
        h1d_df = H1D_all_engine_events(pdf)
        h1d_off_stopped     = _get(h1d_df, "h1d_engine_off_stopped_json",    None)
        h1d_off_running     = _get(h1d_df, "h1d_engine_off_running_json",    None)
        h1d_off_transition  = _get(h1d_df, "h1d_engine_off_transition_json", None)
        h1d_restart_stopped = _get(h1d_df, "h1d_restart_stopped_json",       None)
        h1d_restart_running = _get(h1d_df, "h1d_restart_running_json",       None)
    except Exception as e:
        print(f"[main_ice_trips_fn] H1D_all_engine_events failed for {driver_id}/{trip_id}: {e}")
        h1d_off_stopped = h1d_off_running = h1d_off_transition = None
        h1d_restart_stopped = h1d_restart_running = None

    # ====================================================================
    # 6) Ripple overload duration ratio  (1 row, 8 scalar cols)
    # ====================================================================
    try:
        ripple_df = RIPPLE_overload_duration_ratio_trips(pdf)

        ripple_overload_duration_s = float(_get(ripple_df, "overload_duration_s", 0.0) or 0.0)
        ripple_total_duration_s    = float(_get(ripple_df, "total_duration_s",    0.0) or 0.0)
        ripple_overload_ratio_pct  = float(_get(ripple_df, "overload_ratio_pct",  0.0) or 0.0)
        ripple_nb_samples_overload = int(  _get(ripple_df, "nb_samples_overload", 0)   or 0)
        ripple_nb_samples_total    = int(  _get(ripple_df, "nb_samples_total",    0)   or 0)
        ripple_sample_rate_hz      = float(_get(ripple_df, "sample_rate_hz",      0.0) or 0.0)
        ripple_max_abs_torque_nm   = float(_get(ripple_df, "max_abs_torque_nm",   0.0) or 0.0)
        ripple_max_rpm             = float(_get(ripple_df, "max_rpm",             0.0) or 0.0)
    except Exception as e:
        print(f"[main_ice_trips_fn] RIPPLE_overload_duration_ratio_trips failed for {driver_id}/{trip_id}: {e}")
        ripple_overload_duration_s = 0.0
        ripple_total_duration_s    = 0.0
        ripple_overload_ratio_pct  = 0.0
        ripple_nb_samples_overload = 0
        ripple_nb_samples_total    = 0
        ripple_sample_rate_hz      = 0.0
        ripple_max_abs_torque_nm   = 0.0
        ripple_max_rpm             = 0.0


    out_row = {
        "DRIVER_ID": driver_id,
        "TRIP_ID":   trip_id,

        # stops
        "nbr_arret_mth_demarage_veh_roulant":
            float(_get(stops_df, "nbr_arret_mth_demarage_veh_roulant", 0.0) or 0.0),

        # starts
        "nbr_demarrage_mth_veh_roulant":
            float(_get(starts_df, "nbr_demarrage_mth_veh_roulant", 0.0) or 0.0),
        "nbr_demarrage_mth_veh_arrete":
            float(_get(starts_df, "nbr_demarrage_mth_veh_arrete", 0.0) or 0.0),

        # h2d per gear (7 cols)
        **gear_cols,

        # BS H2D
        "BS_h2d_matrix_json": bs_h2d_json,

        # H1D engine events (5 cols)
        "h1d_engine_off_stopped_json":     h1d_off_stopped,
        "h1d_engine_off_running_json":     h1d_off_running,
        "h1d_engine_off_transition_json":  h1d_off_transition,
        "h1d_restart_stopped_json":        h1d_restart_stopped,
        "h1d_restart_running_json":        h1d_restart_running,

        # Ripple (8 cols)
        "ripple_overload_duration_s": ripple_overload_duration_s,
        "ripple_total_duration_s":    ripple_total_duration_s,
        "ripple_overload_ratio_pct":  ripple_overload_ratio_pct,
        "ripple_nb_samples_overload": ripple_nb_samples_overload,
        "ripple_nb_samples_total":    ripple_nb_samples_total,
        "ripple_sample_rate_hz":      ripple_sample_rate_hz,
        "ripple_max_abs_torque_nm":   ripple_max_abs_torque_nm,
        "ripple_max_rpm":             ripple_max_rpm,
    }

    return pd.DataFrame([out_row])


