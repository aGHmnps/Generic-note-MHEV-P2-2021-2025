def aggregate_BS_h2d_matrix_to_driver_level(pdf: pd.DataFrame) -> pd.DataFrame:
    """
    Aggregate H2D matrices (x, y, z=none: value) for a single driver across all trips.
    
    Input Structure (per trip):
    {
        "x_axis": "regime_BS_mel",
        "y_axis": "couple_BS_mel",
        "x_bins": "min=-100;max=6900;step=50",
        "y_bins": "min=-120;max=110;step=5",
        "matrix": {
            "torque_bin1": {
                "rpm_bin1": {"none": value1},
                "rpm_bin2": {"none": value2}
            },
            "torque_bin2": {...}
        }
    }
    
    Output: Single-row DataFrame per driver with aggregated matrix as JSON string.
    
    Parameters:
    -----------
    pdf : pd.DataFrame
        Input DataFrame for ONE DRIVER_ID with columns:
        - DRIVER_ID (str)
        - month (int)
        - year (int)
        - h2d_matrix_json (str): JSON string of H2D matrix per trip
    
    Returns:
    --------
    pd.DataFrame with schema:
        - DRIVER_ID
        - month
        - year
        - num_trips
        - BS_total_duration_H2D_matrix_rpm_torque_BS (aggregated JSON string)
    """
    
    # Extract driver metadata
    driver_id = pdf['DRIVER_ID'].iloc[0]
    
    # Get most common month/year (mode), handle NaN
    month_mode = pdf['month'].mode()
    year_mode = pdf['year'].mode()
    
    month = int(month_mode.iloc[0]) if len(month_mode) > 0 and pd.notna(month_mode.iloc[0]) else None
    year = int(year_mode.iloc[0]) if len(year_mode) > 0 and pd.notna(year_mode.iloc[0]) else None
    num_trips = int(len(pdf))
    
    # Initialize aggregation storage
    aggregated_matrix = {}
    metadata = None
    
    # Aggregate matrices across all trips for this driver
    for json_str in pdf['h2d_matrix_json'].dropna():
        try:
            data = json.loads(json_str)
            
            # Extract metadata (same across all trips, take first valid one)
            if metadata is None:
                metadata = {
                    'x_axis': data.get('x_axis', ''),
                    'y_axis': data.get('y_axis', ''),
                    'x_bins': data.get('x_bins', ''),
                    'y_bins': data.get('y_bins', '')
                }
            
            # Sum matrix values: navigate nested structure torque_bin -> rpm_bin -> {"none": value}
            trip_matrix = data.get('matrix', {})
            
            for torque_bin, rpm_dict in trip_matrix.items():
                if torque_bin not in aggregated_matrix:
                    aggregated_matrix[torque_bin] = {}
                
                for rpm_bin, z_dict in rpm_dict.items():
                    # Extract value from {"none": value} structure
                    value = float(z_dict.get('none', 0.0))
                    
                    if rpm_bin in aggregated_matrix[torque_bin]:
                        # Sum with existing value
                        aggregated_matrix[torque_bin][rpm_bin]['none'] += value
                    else:
                        # Initialize new bin
                        aggregated_matrix[torque_bin][rpm_bin] = {'none': value}
                        
        except (json.JSONDecodeError, TypeError, KeyError, AttributeError) as e:
            # Skip invalid JSON or malformed data
            print(f"Warning: Skipping invalid matrix for {driver_id}: {e}")
            continue
    
    # Build result JSON string
    if aggregated_matrix and metadata:
        result_json = {
            **metadata,
            'matrix': aggregated_matrix
        }
        aggregated_json_str = json.dumps(result_json)
    else:
        aggregated_json_str = None
    
    # Return single-row DataFrame
    return pd.DataFrame([{
        'DRIVER_ID': driver_id,
        'month': month,
        'year': year,
        'num_trips': num_trips,
        'BS_total_duration_H2D_matrix_rpm_torque_BS': aggregated_json_str
    }])

