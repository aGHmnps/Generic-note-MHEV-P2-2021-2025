def myfunc_mel_revolutions_driver(pdf: pd.DataFrame) -> pd.DataFrame:
    """
    Aggregate MEL revolutions by DRIVER_ID (monthly aggregation).
    Sums nbr_tours_MEL across all trips for each driver per month.
    
    Expected input columns (from nbr_tours_mel_GW output):
    - DRIVER_ID
    - TRIP_ID
    - trip_start2 (ISO timestamp string)
    - trip_end2 (ISO timestamp string)
    - nbr_tours_MEL
    - avg_regime_mel_rpm
    - max_regime_mel_rpm
    - sample_rate_hz
    - duration_seconds
    
    Returns:
    - Aggregated results grouped by DRIVER_ID, month, year
    """
    
    final_columns = [
        'DRIVER_ID', 'month', 'year', 'trip_start', 'trip_end',
        'total_nbr_tours_MEL', 'total_duration_seconds', 'total_duration_hours',
        'avg_regime_mel_rpm', 'max_regime_mel_rpm', 'avg_sample_rate_hz',
        'num_trips'
    ]
    
    # Check for empty input DataFrame
    if pdf.empty:
        return pd.DataFrame({
            'DRIVER_ID': pd.Series(dtype='object'),
            'month': pd.Series(dtype='int64'),
            'year': pd.Series(dtype='int64'),
            'trip_start': pd.Series(dtype='object'),
            'trip_end': pd.Series(dtype='object'),
            'total_nbr_tours_MEL': pd.Series(dtype='float64'),
            'total_duration_seconds': pd.Series(dtype='float64'),
            'total_duration_hours': pd.Series(dtype='float64'),
            'avg_regime_mel_rpm': pd.Series(dtype='float64'),
            'max_regime_mel_rpm': pd.Series(dtype='float64'),
            'avg_sample_rate_hz': pd.Series(dtype='float64'),
            'num_trips': pd.Series(dtype='int64')
        })
    
    # Convert trip_start2 and trip_end2 to datetime for month/year extraction
    pdf['trip_start_dt'] = pd.to_datetime(pdf['trip_start2'], errors='coerce')
    pdf['trip_end_dt'] = pd.to_datetime(pdf['trip_end2'], errors='coerce')
    
    # Extract month and year from trip_start
    pdf['month'] = pdf['trip_start_dt'].dt.month
    pdf['year'] = pdf['trip_start_dt'].dt.year
    
    # Remove rows where month/year couldn't be extracted
    pdf = pdf.dropna(subset=['month', 'year'])
    
    if pdf.empty:
        return pd.DataFrame({col: pd.Series(dtype='object') if col in ['DRIVER_ID', 'trip_start', 'trip_end'] 
                             else pd.Series(dtype='int64') if col in ['month', 'year', 'num_trips']
                             else pd.Series(dtype='float64') 
                             for col in final_columns})
    
    # Define aggregation functions
    aggregation_funcs = {
        'trip_start': ('trip_start2', 'min'),
        'trip_end': ('trip_end2', 'max'),
        
        # SUM of MEL revolutions (main metric)
        'total_nbr_tours_MEL': ('nbr_tours_MEL', 'sum'),
        
        # SUM of duration
        'total_duration_seconds': ('duration_seconds', 'sum'),
        
        # AVERAGE of regime metrics
        'avg_regime_mel_rpm': ('avg_regime_mel_rpm', 'mean'),
        'max_regime_mel_rpm': ('max_regime_mel_rpm', 'max'),
        'avg_sample_rate_hz': ('sample_rate_hz', 'mean'),
        
        # COUNT of trips
        'num_trips': ('TRIP_ID', 'count')
    }
    
    # Perform aggregation by DRIVER_ID, month, year
    agg_df = (
        pdf.groupby(["DRIVER_ID", "month", "year"], as_index=False)
        .agg(**aggregation_funcs)
    )
    
    # Post-Aggregation Calculations
    agg_df["total_duration_hours"] = agg_df["total_duration_seconds"] / 3600.0
    
    # Ensure trip_start and trip_end are strings (not datetime)
    if pd.api.types.is_datetime64_any_dtype(agg_df['trip_start']):
        agg_df["trip_start"] = agg_df["trip_start"].astype(str)
    if pd.api.types.is_datetime64_any_dtype(agg_df['trip_end']):
        agg_df["trip_end"] = agg_df["trip_end"].astype(str)
    
    # Ensure correct data types
    agg_df['month'] = agg_df['month'].astype('int64')
    agg_df['year'] = agg_df['year'].astype('int64')
    agg_df['num_trips'] = agg_df['num_trips'].astype('int64')
    
    return agg_df[final_columns]

def duree_fonctionnement_MEL_driver(pdf: pd.DataFrame) -> pd.DataFrame:
    """
    Aggregate duree_fonctionnement from trip-level to driver-level per mode.
    
    """
    # Handle empty DataFrame
    if pdf.empty:
        return pd.DataFrame({
            'DRIVER_ID': [''],
            'month': [0],
            'year': [0],
            'trip_start': [''],
            'trip_end': [''],
            'avg_duree_vehicule_arrete': [0.0],
            'avg_duree_roulant_mth_off': [0.0],
            'avg_duree_roulant_mth_demarre': [0.0],
            'avg_duree_mode_boost': [0.0],
            'avg_duree_mode_recharge_batterie': [0.0],
            'avg_duree_mode_freinage_regeneratif': [0.0],
            'avg_duree_mode_zev': [0.0],
            'total_duration_seconds': [0.0],
            'total_duration_hours': [0.0],
            'avg_sample_rate_hz': [0.0],
            'num_trips': [0]
        })
    
    # Extract driver metadata
    driver_id = str(pdf['DRIVER_ID'].iloc[0])
    
    # Get earliest trip start and latest trip end
    try:
        from datetime import datetime
        # Parse trip_start2 and trip_end2
        trip_starts = pd.to_datetime(pdf['trip_start2'])
        trip_ends = pd.to_datetime(pdf['trip_end2'])
        
        earliest_start = trip_starts.min()
        latest_end = trip_ends.max()
        
        trip_start_str = earliest_start.strftime('%Y-%m-%d %H:%M:%S')
        trip_end_str = latest_end.strftime('%Y-%m-%d %H:%M:%S')
        
        # Extract month and year from earliest trip
        month = int(earliest_start.month)
        year = int(earliest_start.year)
    except:
        trip_start_str = str(pdf['trip_start2'].iloc[0])
        trip_end_str = str(pdf['trip_end2'].iloc[-1])
        month = 0
        year = 0
    
    # Count unique trips
    num_trips = int(pdf['TRIP_ID'].nunique())
    
    # Calculate average sample rate
    avg_sample_rate_hz = float(pdf['sample_rate_hz'].mean())
    
    mode_columns = [
        'vehicule_arrete_duree_fonctionnement',
        'roulant_mth_off_duree_fonctionnement',
        'roulant_mth_demarre_duree_fonctionnement',
        'mode_boost_duree_fonctionnement',
        'mode_recharge_batterie_duree_fonctionnement',
        'mode_freinage_regeneratif_duree_fonctionnement',
        'mode_zev_duree_fonctionnement'
    ]
    
    # Calculate average for each mode column
    mode_averages = {}
    for mode_col in mode_columns:
        if mode_col in pdf.columns:
            # Average across all trips for this driver
            avg_duration = float(pdf[mode_col].mean())
        else:
            avg_duration = 0.0
        
        # Convert column name: "vehicule_arrete_duree_fonctionnement" -> "avg_duree_vehicule_arrete"
        mode_name = mode_col.replace('_duree_fonctionnement', '')
        mode_averages[f'avg_duree_{mode_name}'] = avg_duration
    
    if 'total_trip_duration_seconds' in pdf.columns:
        total_duration_seconds = float(pdf['total_trip_duration_seconds'].sum())
    else:
        # Fallback: sum all mode durations across all trips
        total_duration_seconds = float(pdf[mode_columns].sum().sum())
    
    total_duration_hours = total_duration_seconds / 3600.0
    
    result = {
        'DRIVER_ID': driver_id,
        'month': month,
        'year': year,
        'trip_start': trip_start_str,
        'trip_end': trip_end_str,
        **mode_averages,  # Unpack all mode averages
        'total_duration_seconds': total_duration_seconds,
        'total_duration_hours': total_duration_hours,
        'avg_sample_rate_hz': avg_sample_rate_hz,
        'num_trips': num_trips
    }
    
    return pd.DataFrame([result])

def MEL_H2D_aggregate_sparse_matrices_todriverLevel(pdf: pd.DataFrame) -> pd.DataFrame:
    """
    Aggregate sparse H2D matrices for a single driver across all trips.
    
    Input: pandas DataFrame for one DRIVER_ID (multiple trips)
    Output: pandas DataFrame with 1 row (aggregated driver-level data)
    """
    
    # Initialize result dictionary
    result = {
        'DRIVER_ID': pdf['DRIVER_ID'].iloc[0],
        'month': int(pdf['month'].mode().iloc[0]) if pd.notna(pdf['month'].mode().iloc[0]) else None,
        'year': int(pdf['year'].mode().iloc[0]) if pd.notna(pdf['year'].mode().iloc[0]) else None,
        'num_trips': int(len(pdf)),
        
        # Aggregate trip-level metrics (sums)
        'total_duration_trip_h': float(pdf['duration_trip_h'].sum()),
        'total_distance_trip_integral_km': float(pdf['distance_trip_integral_km'].sum()),
        'total_sum_distance_CITY_km': float(pdf['sum_distance_CITY_km'].sum()),
        'total_sum_distance_ROAD_km': float(pdf['sum_distance_ROAD_km'].sum()),
        'total_sum_distance_HIGHWAY_km': float(pdf['sum_distance_HIGHWAY_km'].sum()),
    }
    
    # Aggregate each of the 7 H2D modes
    mode_columns = [
        'H2D_duree_MEL_mode_1', 'H2D_duree_MEL_mode_2', 'H2D_duree_MEL_mode_3',
        'H2D_duree_MEL_mode_4', 'H2D_duree_MEL_mode_5', 'H2D_duree_MEL_mode_6',
        'H2D_duree_MEL_mode_7'
    ]
    
    for mode_col in mode_columns:
        # Initialize aggregated matrix storage
        aggregated_matrix = {}
        metadata = None
        
        # Process each trip's matrix for this mode
        for json_str in pdf[mode_col].dropna():
            try:
                data = json.loads(json_str)
                
                # Extract metadata (same for all trips in this mode)
                if metadata is None:
                    metadata = {
                        'x_axis': data.get('x_axis', ''),
                        'y_axis': data.get('y_axis', ''),
                        'x_bins': data.get('x_bins', ''),
                        'y_bins': data.get('y_bins', '')
                    }
                
                # Sum matrix values by bin coordinates
                trip_matrix = data.get('matrix', {})
                for coord, value in trip_matrix.items():
                    if coord in aggregated_matrix:
                        aggregated_matrix[coord] += float(value)
                    else:
                        aggregated_matrix[coord] = float(value)
                        
            except (json.JSONDecodeError, TypeError, KeyError) as e:
                # Skip invalid JSON or malformed data
                continue
        
        # Store aggregated result as JSON string
        if aggregated_matrix and metadata:
            result_json = {
                **metadata,
                'matrix': aggregated_matrix
            }
            result[f'{mode_col}_agg'] = json.dumps(result_json)
        else:
            result[f'{mode_col}_agg'] = None
    
    return pd.DataFrame([result])

