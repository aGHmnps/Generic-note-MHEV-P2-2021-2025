def MEL_H2D_aggregate_sparse_matrices_todriverLevel(pdf: pd.DataFrame) -> pd.DataFrame:
    """
    Aggregate sparse H2D matrices for a single driver across all trips.
    
    Input: pandas DataFrame for one DRIVER_ID (multiple trips)
    Output: pandas DataFrame with 1 row (aggregated driver-level data)
    """
    
    # Initialize result dictionary
    result = {
        'DRIVER_ID': pdf['DRIVER_ID'].iloc[0],
        'month': int(pdf['month'].mode().iloc[0]) if pd.notna(pdf['month'].mode().iloc[0]) else None,
        'year': int(pdf['year'].mode().iloc[0]) if pd.notna(pdf['year'].mode().iloc[0]) else None,
        'num_trips': int(len(pdf)),
        
        # Aggregate trip-level metrics (sums)
        'total_duration_trip_h': float(pdf['duration_trip_h'].sum()),
        'total_distance_trip_integral_km': float(pdf['distance_trip_integral_km'].sum()),
        'total_sum_distance_CITY_km': float(pdf['sum_distance_CITY_km'].sum()),
        'total_sum_distance_ROAD_km': float(pdf['sum_distance_ROAD_km'].sum()),
        'total_sum_distance_HIGHWAY_km': float(pdf['sum_distance_HIGHWAY_km'].sum()),
    }
    
    # Aggregate each of the 7 H2D modes
    mode_columns = [
        'H2D_duree_MEL_mode_1', 'H2D_duree_MEL_mode_2', 'H2D_duree_MEL_mode_3',
        'H2D_duree_MEL_mode_4', 'H2D_duree_MEL_mode_5', 'H2D_duree_MEL_mode_6',
        'H2D_duree_MEL_mode_7'
    ]
    
    for mode_col in mode_columns:
        # Initialize aggregated matrix storage
        aggregated_matrix = {}
        metadata = None
        
        # Process each trip's matrix for this mode
        for json_str in pdf[mode_col].dropna():
            try:
                data = json.loads(json_str)
                
                # Extract metadata (same for all trips in this mode)
                if metadata is None:
                    metadata = {
                        'x_axis': data.get('x_axis', ''),
                        'y_axis': data.get('y_axis', ''),
                        'x_bins': data.get('x_bins', ''),
                        'y_bins': data.get('y_bins', '')
                    }
                
                # Sum matrix values by bin coordinates
                trip_matrix = data.get('matrix', {})
                for coord, value in trip_matrix.items():
                    if coord in aggregated_matrix:
                        aggregated_matrix[coord] += float(value)
                    else:
                        aggregated_matrix[coord] = float(value)
                        
            except (json.JSONDecodeError, TypeError, KeyError) as e:
                # Skip invalid JSON or malformed data
                continue
        
        # Store aggregated result as JSON string
        if aggregated_matrix and metadata:
            result_json = {
                **metadata,
                'matrix': aggregated_matrix
            }
            result[f'{mode_col}_agg'] = json.dumps(result_json)
        else:
            result[f'{mode_col}_agg'] = None
    
    return pd.DataFrame([result])

