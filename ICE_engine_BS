def glyphworks_preprocess_regime(regime_raw):
    """
    GlyphWorks signal preprocessing for engine RPM.
    Pass 1: Keep only rising samples where RPM <= 700, zero out the rest.
    Pass 2: Zero out incomplete ramps that never reach > 500.
    """
    regime = np.array(regime_raw, dtype=np.float32).copy()
    n = len(regime)

    if n < 2:
        return regime

    for pt in range(n - 1):
        if pt == 0:
            pass
        elif regime[pt] <= 700 and regime[pt + 1] >= regime[pt]:
            pass
        else:
            regime[pt] = 0

    deb = 0
    for pt in range(n - 1):
        if regime[pt] == 0 and regime[pt + 1] >= regime[pt]:
            deb = pt + 1
        if regime[pt + 1] > 500:
            deb = 0
        if regime[pt] > 0 and regime[pt + 1] == 0 and regime[pt] < 500:
            fin = pt
            for dec in range(deb, fin, 1):
                regime[dec] = 0

    return regime


