        ["]" + str(p_Bins[i]) + p_Unit + ":" + str(p_Bins[i + 1]) + p_Unit + "]"
         for i in range(1, len(p_Bins) - 1)]
    )
    
    np_durations = np.array(p_durations, dtype=float)
    
    occ = [p_roulage]
    
    # First bin: [Bins[0] : Bins[1]]
    count_i = int(np.sum((np_durations >= p_Bins[0]) & (np_durations <= p_Bins[1])))
    occ.append(count_i)
    
    # Remaining bins: ]Bins[i] : Bins[i+1]]
    for i in range(1, len(p_Bins) - 1):
        count_i = int(np.sum((np_durations > p_Bins[i]) & (np_durations <= p_Bins[i + 1])))
        occ.append(count_i)
    
    return pd.DataFrame([occ], columns=Classes)

def detect_engine_off_phases(p_time, p_engine_rpm, p_vehicle_speed, 
                              engine_off_threshold=50, 
                              vehicle_stopped_threshold=1.0,
                              vehicle_context="stopped"):

    time = np.array(p_time, dtype=float)
    rpm = np.array(p_engine_rpm, dtype=float)
    speed = np.array(p_vehicle_speed, dtype=float)
    
    # Identify engine OFF mask
    engine_off_mask = (rpm < engine_off_threshold).astype(int)
    
    # Get all engine OFF sections
    sections = GetStartEndSection(engine_off_mask)
    
    durations = []
    
    for start_idx, end_idx in sections:
        # Check that this OFF phase is BETWEEN two ON phases
        # i.e., there's engine ON before start and after end
        has_on_before = (start_idx > 0) and (rpm[start_idx - 1] >= engine_off_threshold)
        has_on_after = (end_idx < len(rpm) - 1) and (rpm[end_idx + 1] >= engine_off_threshold)
        
        if not (has_on_before and has_on_after):
            continue
        
        # Check vehicle state during the OFF phase
        phase_speed = speed[start_idx:end_idx + 1]
        
        if vehicle_context == "stopped":
            # Vehicle must be stopped during the entire OFF phase
            if np.all(phase_speed < vehicle_stopped_threshold):
                duration = time[end_idx] - time[start_idx]
                durations.append(duration)
                
        elif vehicle_context == "running":
            # Vehicle must be running during the entire OFF phase
            if np.all(phase_speed >= vehicle_stopped_threshold):
                duration = time[end_idx] - time[start_idx]
                durations.append(duration)
                
        elif vehicle_context == "transition":
            # Vehicle is in transition: mix of running and stopped
            has_stopped = np.any(phase_speed < vehicle_stopped_threshold)
            has_running = np.any(phase_speed >= vehicle_stopped_threshold)
            if has_stopped and has_running:
                duration = time[end_idx] - time[start_idx]
                durations.append(duration)
    
    return durations

def detect_engine_restart_events(p_time, p_engine_rpm, p_vehicle_speed,
                                  engine_off_threshold=50,
                                  vehicle_stopped_threshold=1.0,
                                  vehicle_context="stopped"):

    time = np.array(p_time, dtype=float)
    rpm = np.array(p_engine_rpm, dtype=float)
    speed = np.array(p_vehicle_speed, dtype=float)
    
    # Identify engine OFF mask
    engine_off_mask = (rpm < engine_off_threshold).astype(int)
    
    # Get all engine OFF sections
    sections = GetStartEndSection(engine_off_mask)
    
    durations = []
    
    for start_idx, end_idx in sections:
        # restart at end_idx + 1 (transition from OFF to ON)
        restart_idx = end_idx + 1
        
        if restart_idx >= len(rpm):
            continue
        
        # Verify restart (engine goes ON after)
        if rpm[restart_idx] < engine_off_threshold:
            continue
        
        # Check vehicle state at restart 
        vehicle_speed_at_restart = speed[restart_idx]
        
        if vehicle_context == "stopped" and vehicle_speed_at_restart >= vehicle_stopped_threshold:
            continue
        elif vehicle_context == "running" and vehicle_speed_at_restart < vehicle_stopped_threshold:
            continue
        
        # Duration of the OFF phase that preceded this restart
        duration = time[end_idx] - time[start_idx]
        durations.append(duration)
    
    return durations

