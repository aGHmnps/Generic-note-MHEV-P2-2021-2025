import json
import pandas as pd

def main_ice_driver_fn(pdf: pd.DataFrame) -> pd.DataFrame:
    """
    Master driver-level function. Aggregates trip-level metrics
    (output of main_ice_trips_fn, enriched with month/year)
    into a single row per (DRIVER_ID, month, year) matching
    `main_ice_driver_schema`.

    Expected input columns (trip-level, one row per trip):
        DRIVER_ID, TRIP_ID, month, year,
        # stops/starts (scalars)
        nbr_arret_mth_demarage_veh_roulant,
        nbr_demarrage_mth_veh_roulant, nbr_demarrage_mth_veh_arrete,
        # ICE H2D per gear (7 JSON cols)
        h2d_duree_ICE_gear_0_json ... h2d_duree_ICE_gear_6_json,
        # BS H2D
        BS_h2d_matrix_json,
        # H1D engine events
        h1d_engine_off_stopped_json, h1d_engine_off_running_json,
        h1d_engine_off_transition_json,
        h1d_restart_stopped_json, h1d_restart_running_json,
        # Ripple scalars
        ripple_overload_duration_s, ripple_total_duration_s,
        ripple_overload_ratio_pct, ripple_nb_samples_overload,
        ripple_nb_samples_total, ripple_sample_rate_hz,
        ripple_max_abs_torque_nm, ripple_max_rpm
    """

    # ---- Empty input safeguard ----
    if pdf is None or pdf.empty:
        empty = {f.name: None for f in main_ice_driver_schema.fields}
        return pd.DataFrame([empty])

    driver_id = str(pdf["DRIVER_ID"].iloc[0]) if "DRIVER_ID" in pdf.columns else ""

    # month/year (mode is robust if multiple rows differ slightly)
    month = year = None
    if "month" in pdf.columns:
        m_mode = pdf["month"].mode()
        if len(m_mode) > 0 and pd.notna(m_mode.iloc[0]):
            month = int(m_mode.iloc[0])
    if "year" in pdf.columns:
        y_mode = pdf["year"].mode()
        if len(y_mode) > 0 and pd.notna(y_mode.iloc[0]):
            year = int(y_mode.iloc[0])

    num_trips = int(pdf["TRIP_ID"].nunique()) if "TRIP_ID" in pdf.columns else int(len(pdf))

    # Helper to safely get scalar from a (1-row) result df
    def _get(df, col, default=None):
        try:
            if df is None or df.empty or col not in df.columns:
                return default
            return df[col].iloc[0]
        except Exception:
            return default

    # ====================================================================
    # 1) ICE stops aggregate
    # ====================================================================
    try:
        stops_df = aggregate_ICE_stops_to_driver_level(pdf)
        stops_total = float(_get(stops_df, "nbr_arret_mth_demarage_veh_roulant", 0.0) or 0.0)
    except Exception as e:
        print(f"[main_ice_driver_fn] aggregate_ICE_stops_to_driver_level failed for {driver_id}: {e}")
        stops_total = 0.0

    # ====================================================================
    # 2) ICE starts aggregate
    # ====================================================================
    try:
        starts_df = aggregate_ICE_starts_to_driver_level(pdf)
        starts_roulant = float(_get(starts_df, "nbr_demarrage_mth_veh_roulant", 0.0) or 0.0)
        starts_arrete  = float(_get(starts_df, "nbr_demarrage_mth_veh_arrete",  0.0) or 0.0)
    except Exception as e:
        print(f"[main_ice_driver_fn] aggregate_ICE_starts_to_driver_level failed for {driver_id}: {e}")
        starts_roulant = 0.0
        starts_arrete  = 0.0

    # ====================================================================
    # 3) H2D ICE per gear aggregates (7 JSON cols → 7 aggregated JSON cols)
    # ====================================================================
    gear_aggs = {f"H2D_duree_ICE_gear_{g}_agg": "{}" for g in range(7)}
    try:
        for g in range(7):
            src_col = f"h2d_duree_ICE_gear_{g}_json"
            if src_col in pdf.columns:
                json_strings = pdf[src_col].dropna().tolist()
                if json_strings:
                    gear_aggs[f"H2D_duree_ICE_gear_{g}_agg"] = (
                        _aggregate_matrix_jsons_matrix_only(json_strings)
                    )
    except Exception as e:
        print(f"[main_ice_driver_fn] H2D per-gear aggregation failed for {driver_id}: {e}")

    # ====================================================================
    # 4) BS H2D aggregate
    #    aggregate_BS_h2d_matrix_to_driver_level expects column 'h2d_matrix_json'
    # ====================================================================
    bs_h2d_agg = None
    try:
        bs_input = pdf.copy()
        if "BS_h2d_matrix_json" in bs_input.columns and "h2d_matrix_json" not in bs_input.columns:
            bs_input = bs_input.rename(columns={"BS_h2d_matrix_json": "h2d_matrix_json"})
        bs_df = aggregate_BS_h2d_matrix_to_driver_level(bs_input)
        bs_h2d_agg = _get(bs_df, "BS_total_duration_H2D_matrix_rpm_torque_BS", None)
    except Exception as e:
        print(f"[main_ice_driver_fn] aggregate_BS_h2d_matrix_to_driver_level failed for {driver_id}: {e}")

    # ====================================================================
    # 5) H1D engine events aggregates (5 JSON cols)
    # ====================================================================
    h1d_off_stopped = h1d_off_running = h1d_off_transition = None
    h1d_restart_stopped = h1d_restart_running = None
    try:
        h1d_df = aggregate_h1d_engine_events_to_driver_level(pdf)
        h1d_off_stopped     = _get(h1d_df, "h1d_engine_off_stopped_driver_json",    None)
        h1d_off_running     = _get(h1d_df, "h1d_engine_off_running_driver_json",    None)
        h1d_off_transition  = _get(h1d_df, "h1d_engine_off_transition_driver_json", None)
        h1d_restart_stopped = _get(h1d_df, "h1d_restart_stopped_driver_json",       None)
        h1d_restart_running = _get(h1d_df, "h1d_restart_running_driver_json",       None)
    except Exception as e:
        print(f"[main_ice_driver_fn] aggregate_h1d_engine_events_to_driver_level failed for {driver_id}: {e}")

    # ====================================================================
    # 6) Ripple aggregate
    #    RIPPLE_overload_duration_ratio_drivers expects unprefixed columns
    # ====================================================================
    ripple = {
        "ripple_overload_duration_s": 0.0,
        "ripple_total_duration_s":    0.0,
        "ripple_overload_ratio_pct":  0.0,
        "ripple_nb_samples_overload": 0,
        "ripple_nb_samples_total":    0,
        "ripple_avg_sample_rate_hz":  0.0,
        "ripple_max_abs_torque_nm":   0.0,
        "ripple_max_rpm":             0.0,
    }
    try:
        ripple_input = pdf.rename(columns={
            "ripple_overload_duration_s": "overload_duration_s",
            "ripple_total_duration_s":    "total_duration_s",
            "ripple_overload_ratio_pct":  "overload_ratio_pct",
            "ripple_nb_samples_overload": "nb_samples_overload",
            "ripple_nb_samples_total":    "nb_samples_total",
            "ripple_sample_rate_hz":      "sample_rate_hz",
            "ripple_max_abs_torque_nm":   "max_abs_torque_nm",
            "ripple_max_rpm":             "max_rpm",
        })
        ripple_df = RIPPLE_overload_duration_ratio_drivers(ripple_input)

        ripple["ripple_overload_duration_s"] = float(_get(ripple_df, "overload_duration_s", 0.0) or 0.0)
        ripple["ripple_total_duration_s"]    = float(_get(ripple_df, "total_duration_s",    0.0) or 0.0)
        ripple["ripple_overload_ratio_pct"]  = float(_get(ripple_df, "overload_ratio_pct",  0.0) or 0.0)
        ripple["ripple_nb_samples_overload"] = int(  _get(ripple_df, "nb_samples_overload", 0)   or 0)
        ripple["ripple_nb_samples_total"]    = int(  _get(ripple_df, "nb_samples_total",    0)   or 0)
        ripple["ripple_avg_sample_rate_hz"]  = float(_get(ripple_df, "avg_sample_rate_hz",  0.0) or 0.0)
        ripple["ripple_max_abs_torque_nm"]   = float(_get(ripple_df, "max_abs_torque_nm",   0.0) or 0.0)
        ripple["ripple_max_rpm"]             = float(_get(ripple_df, "max_rpm",             0.0) or 0.0)
    except Exception as e:
        print(f"[main_ice_driver_fn] RIPPLE_overload_duration_ratio_drivers failed for {driver_id}: {e}")

    out_row = {
        # keys
        "DRIVER_ID": driver_id,
        "month":     month,
        "year":      year,
        "num_trips": num_trips,

        # stops
        "nbr_arret_mth_demarage_veh_roulant": stops_total,

        # starts
        "nbr_demarrage_mth_veh_roulant": starts_roulant,
        "nbr_demarrage_mth_veh_arrete":  starts_arrete,

        # h2d per gear (7 cols)
        **gear_aggs,

        # BS H2D
        "BS_total_duration_H2D_matrix_rpm_torque_BS": bs_h2d_agg,

        # H1D engine events (5 cols)
        "h1d_engine_off_stopped_driver_json":    h1d_off_stopped,
        "h1d_engine_off_running_driver_json":    h1d_off_running,
        "h1d_engine_off_transition_driver_json": h1d_off_transition,
        "h1d_restart_stopped_driver_json":       h1d_restart_stopped,
        "h1d_restart_running_driver_json":       h1d_restart_running,

        # Ripple (8 cols)
        **ripple,
    }

    return pd.DataFrame([out_row])

