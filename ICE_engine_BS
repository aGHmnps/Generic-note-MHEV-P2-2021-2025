import numpy as np
import pandas as pd
from statistics import mean
import json

def GetStartEndSection(a):
    a = np.asarray(a, dtype=np.int8)
    iszero = np.concatenate(([1], np.equal(a, 0).view(np.int8), [1]))
    absdiff = np.abs(np.diff(iszero))
    ranges = np.where(absdiff == 1)[0].reshape(-1, 2)
    ranges = [[x[0], x[1] - 1] for x in ranges]
    return ranges

def GetPhaseDurations(p_time, p_condition_mask):
    time = np.array(p_time, dtype=float)
    mask = np.array(p_condition_mask, dtype=int)
    sections = GetStartEndSection(mask)
    
    durations = []
    for start_idx, end_idx in sections:
        duration = time[end_idx] - time[start_idx]
        durations.append(duration)
    
    return durations, sections

def H1D_EVENT_COUNT(p_durations, p_Bins, p_Unit, p_roulage):
