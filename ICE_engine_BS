# Helper: sum dicts (or JSON strings) key by key
def sum_dicts(dicts):
    total = Counter()
    for d in dicts:
        if isinstance(d, dict):
            total.update(d)
        elif isinstance(d, str):
            try:
                total.update(json.loads(d))  # handle JSON-like strings
            except:
                pass
    return dict(total)

