def assign_bin_index_exact(values, bins):
    values = np.asarray(values, dtype=float)
    out = np.full(values.shape, np.nan)
    for i in range(len(bins) - 1):
        low, high = bins[i], bins[i + 1]
        if i == 0:
            mask = (values >= low) & (values <= high)
        else:
            mask = (values > low) & (values <= high)
        out[mask] = i
    return out

def _get_bin_metadata(bins):
    if len(bins) < 2:
        return "min=0;max=0;step=0"
    bin_min = bins[0]
    bin_max = bins[-1]
    step = bins[1] - bins[0] if len(bins) > 1 else 0
    if float(step).is_integer():
        return f"min={int(bin_min)};max={int(bin_max)};step={int(step)}"
    return f"min={bin_min};max={bin_max};step={step}"

def _build_bin_label(i, low, high, unit):
    idx_str = f"{i:04d}"
    low_str = str(int(low)) if float(low).is_integer() else str(low)
    high_str = str(int(high)) if float(high).is_integer() else str(high)
    if i == 0:
        return f"{idx_str} [{low_str}{unit}:{high_str}{unit}]"
    else:
        return f"{idx_str} ]{low_str}{unit}:{high_str}{unit}]"

def _build_all_bin_labels(bins, unit):
    labels = []
    for i in range(len(bins) - 1):
        labels.append(_build_bin_label(i, bins[i], bins[i + 1], unit))
    return labels

def detect_engine_stops_gw(rpm_values, stop_threshold=500):
    """
    GW logic: count sections where RPM < stop_threshold.
    Each transition from RPM >= threshold to RPM < threshold = one stop event.
    Edge case: if signal starts below threshold, count as first section.
    """
    rpm = np.asarray(rpm_values, dtype=float)
    n = len(rpm)
    if n < 2:
        return []
    stop_indices = []
    was_above = rpm[0] >= stop_threshold
    if not was_above:
        stop_indices.append(0)
    for i in range(1, n):
        is_above = rpm[i] >= stop_threshold
        if was_above and not is_above:
            stop_indices.append(i)
        was_above = is_above
    return stop_indices

def ICE_stops_per_trip(pdf: pd.DataFrame) -> pd.DataFrame:
    """
    applyInPandas function: counts ICE engine stops (GW logic) per trip.
    
    Stop = RPM crosses from >= 500 to < 500 (section where arret_mth == 1).
    
    Output schema:
        DRIVER_ID: str
        TRIP_ID: double
        nbr_arret_mth_demarage_veh_roulant: double (count of stops)
    """
    pdf = pdf.copy()

    if pdf.empty:
        return pd.DataFrame(columns=[
            "DRIVER_ID",
            "TRIP_ID",
            "nbr_arret_mth_demarage_veh_roulant"
        ])

    pdf = pdf.sort_values("TIMESTAMP").reset_index(drop=True)

    driver_id = str(pdf["DRIVER_ID"].iloc[0]) if "DRIVER_ID" in pdf.columns else ""
    trip_id = float(pdf["TRIP_ID"].iloc[0]) if "TRIP_ID" in pdf.columns else 0.0

    rpm_values = pd.to_numeric(pdf["REGIME_MOTEUR"], errors="coerce").values.astype(float)
    rpm_values = np.clip(rpm_values, CONFIG_stops['engine_rpm_min'], CONFIG_stops['engine_rpm_max'])

    # GW logic: sections where RPM < 500
    stop_indices = detect_engine_stops_gw(
        rpm_values,
        stop_threshold=CONFIG_stops['engine_stop_threshold']
    )

    return pd.DataFrame([{
        "DRIVER_ID": driver_id,
        "TRIP_ID": trip_id,
        "nbr_arret_mth_demarage_veh_roulant": float(len(stop_indices))
    }])

