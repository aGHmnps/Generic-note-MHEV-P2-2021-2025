###DRIVER level functions
def RIPPLE_overload_duration_ratio_drivers(pdf):

    import numpy as np
    import pandas as pd
    
    driver_id_col = 'DRIVER_ID'
    
    if len(pdf) == 0:
        return pd.DataFrame({
            'DRIVER_ID':              pd.Series(dtype='object'),
            'month':                  pd.Series(dtype='int64'),
            'year':                   pd.Series(dtype='int64'),
            'nb_trips':               pd.Series(dtype='int64'),
            'overload_duration_s':    pd.Series(dtype='float64'),
            'total_duration_s':       pd.Series(dtype='float64'),
            'overload_ratio_pct':     pd.Series(dtype='float64'),
            'nb_samples_overload':    pd.Series(dtype='int64'),
            'nb_samples_total':       pd.Series(dtype='int64'),
            'avg_sample_rate_hz':     pd.Series(dtype='float64'),
            'max_abs_torque_nm':      pd.Series(dtype='float64'),
            'max_rpm':                pd.Series(dtype='float64'),
        })
    
    driver_id = str(pdf[driver_id_col].iloc[0])
    
    month_val = int(pdf["month"].iloc[0]) if "month" in pdf.columns else 0
    year_val  = int(pdf["year"].iloc[0])  if "year"  in pdf.columns else 0

    total_overload_s    = float(pdf['overload_duration_s'].sum())
    total_duration_s    = float(pdf['total_duration_s'].sum())
    nb_samples_overload = int(pdf['nb_samples_overload'].sum())
    nb_samples_total    = int(pdf['nb_samples_total'].sum())
    nb_trips            = len(pdf)

    if total_duration_s > 0:
        overload_ratio_pct = (total_overload_s / total_duration_s) * 100.0
    else:
        overload_ratio_pct = 0.0

    max_abs_torque_nm = float(pdf['max_abs_torque_nm'].max())
    max_rpm           = float(pdf['max_rpm'].max())
    
    avg_sample_rate_hz = float(pdf['sample_rate_hz'].mean())
    
    return pd.DataFrame([{
        'DRIVER_ID':           driver_id,
        'month':               month_val,
        'year':                year_val,
        'nb_trips':            nb_trips,
        'overload_duration_s': total_overload_s,
        'total_duration_s':    total_duration_s,
        'overload_ratio_pct':  overload_ratio_pct,
        'nb_samples_overload': nb_samples_overload,
        'nb_samples_total':    nb_samples_total,
        'avg_sample_rate_hz':  avg_sample_rate_hz,
        'max_abs_torque_nm':   max_abs_torque_nm,
        'max_rpm':             max_rpm,
    }])


