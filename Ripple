#trips level function
def RIPPLE_overload_duration_ratio_trips(pdf):

    import numpy as np
    import pandas as pd
    
    # ── Thresholds ──
    TORQUE_ABS_HIGH = 105.0    # N.m – overload regardless of RPM
    TORQUE_ABS_LOW  = 45.0     # N.m – overload only if RPM > threshold
    RPM_THRESHOLD   = 1500.0   # rpm
    
    # ── Column mapping (adapt to your actual column names) ──
    time_col      = 'TIMESTAMP'
    torque_col    = 'Torque_MEL'
    rpm_col       = 'RPM_MEL'         
    vin_col       = 'VIN'
    driver_id_col = 'DRIVER_ID'
    trip_id_col   = 'TRIP_ID'
    
    # ── Empty result template ──
    empty_result = pd.DataFrame({
        'TRIP_ID':                pd.Series(dtype='object'),
        'DRIVER_ID':              pd.Series(dtype='object'),
        'overload_duration_s':    pd.Series(dtype='float64'),
        'total_duration_s':       pd.Series(dtype='float64'),
        'overload_ratio_pct':     pd.Series(dtype='float64'),
        'nb_samples_overload':    pd.Series(dtype='int64'),
        'nb_samples_total':       pd.Series(dtype='int64'),
        'sample_rate_hz':         pd.Series(dtype='float64'),
        'max_abs_torque_nm':      pd.Series(dtype='float64'),
        'max_rpm':                pd.Series(dtype='float64')
    })
    
    # ── Validate required columns ──
    # required_cols = [time_col, torque_col, rpm_col, vin_col, trip_id_col, driver_id_col]
    # if not all(col in pdf.columns for col in required_cols):
    #     return empty_result
    
    # ── Sort & clean ──
    pdf = pdf.sort_values(time_col).reset_index(drop=True)
    pdf = pdf.dropna(subset=[time_col, torque_col, rpm_col])
    
    if len(pdf) < 2:
        return pd.DataFrame([{
            'TRIP_ID':             pdf[trip_id_col].iloc[0] if len(pdf) > 0 else None,
            'DRIVER_ID':           pdf[driver_id_col].iloc[0] if len(pdf) > 0 else None,
            'overload_duration_s': 0.0,
            'total_duration_s':    0.0,
            'overload_ratio_pct':  0.0,
            'nb_samples_overload': 0,
            'nb_samples_total':    0,
            'sample_rate_hz':      0.0,
            'max_abs_torque_nm':   0.0,
            'max_rpm':             0.0
        }])
    
    # ── Get identifiers ──
    trip_id   = int(float(pdf[trip_id_col].iloc[0]))
    driver_id = str(pdf[driver_id_col].iloc[0])
    
    # ── Extract signals ──
    times      = pdf[time_col].values.astype(float)
    torque     = pdf[torque_col].values.astype(float)
    rpm        = pdf[rpm_col].values.astype(float)
    abs_torque = np.abs(torque)
    
    # ── Compute overload boolean mask ──
    # Condition A: |torque| > 105 N.m (any RPM)
    cond_A = abs_torque > TORQUE_ABS_HIGH
    
    # Condition B: |torque| > 45 N.m AND RPM > 1500
    cond_B = (abs_torque > TORQUE_ABS_LOW) & (rpm > RPM_THRESHOLD)
    
    # Combined
    overload_mask = cond_A | cond_B
    
    # ── Compute durations ──
    # Use median sample period for robustness (same as your GW method)
    time_deltas   = np.diff(times)
    sample_period = float(np.median(time_deltas))
    sample_rate_hz = 1.0 / sample_period if sample_period > 0 else 0.0
    
    # Total duration: (N-1) * sample_period (GlyphWorks convention)
    total_duration_s = (len(times) - 1) * sample_period
    
    # Overload duration: number of overload samples * sample_period
    # Note: we use sum of mask (each True sample = 1 sample_period of overload)
    nb_samples_overload = int(overload_mask.sum())
    nb_samples_total    = len(times)
    overload_duration_s = nb_samples_overload * sample_period
    
    # ── Ratio ──
    if total_duration_s > 0:
        overload_ratio_pct = (overload_duration_s / total_duration_s) * 100.0
    else:
        overload_ratio_pct = 0.0
    
    # ── Statistics ──
    max_abs_torque_nm = float(np.max(abs_torque))
    max_rpm           = float(np.max(rpm))
    
    
    return pd.DataFrame([{
        'TRIP_ID':             trip_id,
        'DRIVER_ID':           driver_id,
        'overload_duration_s': overload_duration_s,
        'total_duration_s':    total_duration_s,
        'overload_ratio_pct':  overload_ratio_pct,
        'nb_samples_overload': nb_samples_overload,
        'nb_samples_total':    nb_samples_total,
        'sample_rate_hz':      sample_rate_hz,
        'max_abs_torque_nm':   max_abs_torque_nm,
        'max_rpm':             max_rpm
    }])


